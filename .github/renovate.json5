{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
  ],
  packageRules: [
    {
      enabled: false,
      matchPackageNames: [
        'org.apache.maven:*',
        'org.apache.maven.plugin-tools:*',
      ],
    },
    {
      enabled: false,
      matchPackageNames: [
        'com.palantir.javaformat:palantir-java-format',
      ],
      matchCurrentVersion: '<= 1.1.0',
    },
    {
      groupName: 'Ktlint',
      matchPackageNames: [
        'com.pinterest.ktlint:*',
      ],
    },
    {
      groupName: 'OpenRewrite',
      matchPackageNames: [
        'org.openrewrite.recipe:*',
      ],
    },
  ],
}
